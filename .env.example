# LOCKBOT environment template.
#
# Copy to .env and fill in. The real .env is gitignored and must never be
# committed — it holds live broker credentials.

# --- Alpaca (paper) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Anthropic, for the conversational brain and the learning pass ---
# Trading does not use this. An empty balance stops LOCKBOT answering
# questions; it does not stop the scanner, the risk gates or the options
# stop loss.
CLAUDE_API_KEY=

# --- Pushover alerts ---
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# --- Telegram remote access ---
# TELEGRAM_ALLOWED_USER_IDS is the entire security model: anyone holding
# the token can drive the bot, but only listed IDs get answers. Leave it
# empty on first run — message the bot and its refusal reports your ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Voice ---
# Run "python lockbot_voice.py --mics", speak when prompted, and put the
# winning device number here. Without it LOCKBOT uses the Windows default,
# which on a machine with virtual audio devices is often not a real
# microphone at all.
LOCKBOT_MIC_INDEX=
LOCKBOT_EDGE_VOICE=en-GB-RyanNeural
LOCKBOT_EDGE_RATE=-6%
LOCKBOT_EDGE_PITCH=-3Hz

# --- SOLAS, the second agent (added 2026-08-13) ---
#
# Its own key, deliberately NOT shared with CLAUDE_API_KEY above. Two
# reasons, both learned here the hard way:
#
#   Blast radius. The Anthropic balance ran empty on 2026-08-12 and took
#   down the brain, the nightly learning pass and Telegram answers in one
#   go. Separate keys mean one agent running dry does not silence the
#   other.
#
#   Attribution. Separate keys make it possible to tell which agent spent
#   what, and to revoke one without touching the other.
#
# Neither agent's key touches trading. The scanner, the risk gates and the
# options stop loss run without any of them.
#
# If project CODE needs to read this, add the name to lockbot_config.py
# the way ALPACA_API_KEY_ENV does, rather than hardcoding the string at
# the call site — lockbot_config.py is the single source of truth for
# every shared setting, and a bare os.getenv() in a module is how that
# invariant gets broken.
SOLAS_API_KEY=

# --- Optional tuning ---
# LOCKBOT_EFFORT_CHAT=medium        raise to "high" if answers feel shallow
# LOCKBOT_CONVERSATION_TIMEOUT=90   seconds the mic stays open between turns
# LOCKBOT_PERSONA=jarvis            set to "plain" to drop the register
